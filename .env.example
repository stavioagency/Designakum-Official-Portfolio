# Sessions. REQUIRED in production: the app refuses to start without at least 32
# random characters. Generate one with: openssl rand -base64 48
# In development a private secret is generated into data/.dev-session-secret.
AUTH_SECRET=

# Google sign-in. Create an OAuth client (type: Web application) in Google Cloud,
# and add <origin>/api/auth/google/callback as an authorised redirect URI.
# Both values must be present or the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the callback URL differs from <request origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Payments. Until BILLING_PROVIDER and BILLING_SECRET_KEY are both set, checkout
# is disabled in the UI and subscriptions can only be granted by the platform owner.
BILLING_PROVIDER=
BILLING_SECRET_KEY=
BILLING_PUBLIC_KEY=
BILLING_WEBHOOK_SECRET=


# Optional: seed a second owner and a support account with your own credentials
# instead of the demo ones (see scripts/seed.mjs).

# Transactional email (password resets). Without these the reset link cannot be
# delivered and the app says so instead of pretending to send one; every message
# is still recorded in the mail_outbox table.
EMAIL_PROVIDER=          # currently supported: resend
EMAIL_API_KEY=
EMAIL_FROM=              # e.g. "Designakum <no-reply@designakum.sa>"

# Optional: forward structured error reports to a collector (Sentry tunnel,
# Slack webhook, anything that accepts JSON).
ERROR_WEBHOOK_URL=

# Backups (npm run backup)
BACKUP_DIR=              # default: data/backups
BACKUP_KEEP=             # default: 14

# Image storage. Development writes to data/uploads; production must use Supabase
# Storage, because a serverless filesystem is wiped between invocations.
# Create a PRIVATE bucket named portfolio-images — reads go through the app so a
# suspended portfolio's images stop being served.
STORAGE_DRIVER=            # local | supabase (inferred from the two below)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # server-side only, never exposed to the browser
SUPABASE_STORAGE_BUCKET=   # default: portfolio-images

# PostgreSQL. From Supabase: Project Settings -> Database -> Connection string
# -> Transaction pooler.
DATABASE_URL=
DATABASE_POOL_MAX=         # default: 5
