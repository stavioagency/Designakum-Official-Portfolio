{
  "name": "designakum-portfolio-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "node scripts/seed.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "preview:emails": "node scripts/preview-emails.mts",
    "test": "node --test --test-concurrency=1 tests/",
    "test:unit": "node --test tests/safe-url.test.ts tests/image-info.test.ts",
    "migrate": "node scripts/migrate.mjs",
    "migrate:down": "node scripts/migrate.mjs --down",
    "bootstrap": "node scripts/bootstrap.mjs",
    "brand:manifest": "node scripts/brand-manifest.mjs",
    "prebuild": "node scripts/brand-manifest.mjs",
    "build:local": "NEXT_DIST_DIR=.next-build next build",
    "start:local": "NEXT_DIST_DIR=.next-build next start -p 3000",
    "pretest": "node scripts/check-dev-server.mjs"
  },
  "dependencies": {
    "eslint-config-next": "^15.5.25",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.2"
  }
}
